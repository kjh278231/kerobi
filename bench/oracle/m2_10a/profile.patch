+        let mut sp2 = Spx::unscaled(md);
+        if md.sense < 0 { for c in &mut sp2.c { *c = -*c; } }
+        let mut e2 = Engine::new(&sp2);
+        e2.iter = e.iter;
+        e2.iter_limit = iter_limit;
+        e2.trace_on = false;
+        if let Some(st) = e2.resolve_unscaled(e.vstat.clone()) {
+            let xs = e2.x();
