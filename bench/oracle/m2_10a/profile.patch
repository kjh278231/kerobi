+fn replay_lp(md: &Model, iter_limit: u64, real: &rsolver_lp::simplex::LpResult, warm: Option<(&[i32], &[i32])>, ph: &mut [f64; 4]) {
+    use rsolver_lp::{simplex::{Engine, Status}, spx::Spx};
+    let t = std::time::Instant::now();
+    let mut spx = Spx::new(md);
+    if md.sense < 0 { for c in &mut spx.c { *c = -*c; } }
+    ph[0] += secs(t);
+    let t = std::time::Instant::now();
+    let mut e = Engine::new(&spx);
+    e.iter_limit = iter_limit;
+    e.trace_on = false;
+    ph[1] += secs(t);
+    let t = std::time::Instant::now();
+    let status = match warm { Some((vb, cb)) => e.solve_warm(vb, cb), None => e.solve(1) };
